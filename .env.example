# Website-only key; takes precedence over a shared Windows BAZE_API_KEY.
# Never change Codex settings or shared environment variables to set this key.
AI_PROVIDER=baze
THINKMATE_BAZE_API_KEY=
BAZE_MODEL=gpt-5.6-sol
BAZE_EMBEDDING_MODEL=text-embedding-3-small

# Copy to .env. Never put these values in the browser.
# Shared by question generation, grading, student review, and RAG.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PORT=4173
TEACHER_PASSWORD=
# Optional external OCR service accepting the multipart API contract.
OCR_BACKEND_URL=
